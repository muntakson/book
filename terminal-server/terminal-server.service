[Unit]
Description=BookMaker Terminal Server
After=network.target

[Service]
Type=simple
User=jit
WorkingDirectory=/var/www/aibook/bookmaker/terminal-server
ExecStart=/usr/bin/node /var/www/aibook/bookmaker/terminal-server/server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=terminal-server

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/www/aibook
EnvironmentFile=/var/www/aibook/bookmaker/terminal-server/.env

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

[Install]
WantedBy=multi-user.target
